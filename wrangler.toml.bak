name = "blanc-data"
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat"]

# Cloudflare D1 Database Binding
# When deploying to Cloudflare Pages, bind this database as 'DB' in the Cloudflare Dashboard:
# Workers & Pages -> Your Project -> Settings -> Functions -> D1 Database Bindings -> Variable name: DB
[[d1_databases]]
binding = "DB"
database_name = "blanc_data_db"
database_id = "031367e3-ccc4-4996-bd8c-65386f84a5ea"
migrations_dir = "db"
